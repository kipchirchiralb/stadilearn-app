# Copy to .env.local and fill in. Never commit real values.

# Public URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MOODLE_URL=https://elearning.stadilearn.co.ke

# Custom (main) Stadilearn database — read/write, owned by this app. Create it with schema.sql.
CUSTOM_DB_HOST=localhost
CUSTOM_DB_PORT=3306
CUSTOM_DB_NAME=stadilearn
CUSTOM_DB_USER=stadilearn_app
CUSTOM_DB_PASSWORD=
# Restricted AI user: SELECT on ai_v_* views and rag_* tables only (see db-grants.sql).
# e.g. stadilearn_ai. If unset, the AI falls back to CUSTOM_DB_USER. Set it in production.
CUSTOM_DB_AI_USER=
CUSTOM_DB_AI_PASSWORD=

# Moodle database — dedicated READ-ONLY account (SELECT only). Never write to Moodle.
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=3306
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_readonly
MOODLE_DB_PASSWORD=
MOODLE_DB_PREFIX=mdl_
# Restricted Moodle user for the AI and the indexer: content + completion tables only, no mdl_user.
# e.g. moodle_ai_ro. If unset, falls back to MOODLE_DB_USER. Set it in production.
MOODLE_AI_DB_USER=
MOODLE_AI_DB_PASSWORD=

# Sessions and OTP (next phase)
SESSION_SECRET=
OTP_TTL_SECONDS=600

# Email (OTP + notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=no-reply@stadilearn.co.ke
SMTP_PASSWORD=
MAIL_FROM="Stadilearn <no-reply@stadilearn.co.ke>"

# AI provider (provider-neutral adapter; key stays server-side)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
# Optional: override the provider API base URL (e.g. an API gateway). Leave blank for the default.
AI_BASE_URL=
# Embeddings for RAG. Changing either builds a new index version on the next `npm run ai:index`.
AI_EMBED_MODEL=gemini-embedding-001
AI_EMBED_DIMENSIONS=768
# Optional USD prices per million tokens, for the usage ledger's cost estimate (0 on free tiers).
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
